{
  "name": "ng-js-vite",
  "version": "1.0.0",
  "description": "Vite plugin that emits content-hashed AngularJS templates and scopes styleUrl CSS into Vite's bundled stylesheet.",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "import": "./dist/esbuild.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IonCna/ng-js-vite.git"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Max Flores",
  "keywords": [
    "vite",
    "vite-plugin",
    "angularjs",
    "templateUrl",
    "styleUrl"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/css-tree": "^3.2.0",
    "tsup": "^8.5.1"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0",
    "vite": ">=2.0.0"
  },
  "dependencies": {
    "css-tree": "^3.2.1",
    "parse5": "^8.0.1"
  }
}
